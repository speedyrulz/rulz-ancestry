{
  "name": "@rulz/desktop",
  "productName": "RulZ Ancestry",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Windows genealogy app built on free data sources",
  "author": "RulZ Ancestry contributors",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false && tsc --noEmit -p tsconfig.e2e.json --composite false",
    "test:e2e": "playwright test --project=built",
    "test:e2e:packaged": "playwright test --project=packaged",
    "package": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "package:dir": "electron-vite build && electron-builder --win --x64 --dir --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@rulz/connectors": "workspace:*",
    "@rulz/core": "workspace:*",
    "@rulz/db": "workspace:*",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "d3-geo": "^3.1.2",
    "electron": "45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  }
}
