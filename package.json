{
  "name": "rulz-ancestry",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Windows genealogy app built on free data sources",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @rulz/desktop dev",
    "build": "pnpm --filter @rulz/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @rulz/desktop test:e2e",
    "test:e2e:packaged": "pnpm --filter @rulz/desktop test:e2e:packaged",
    "package": "pnpm --filter @rulz/desktop package",
    "package:dir": "pnpm --filter @rulz/desktop package:dir"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
